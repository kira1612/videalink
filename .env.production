# ============================================================
# FRONTEND (Vite) - dipakai saat `npm run build`
# Aktifkan HANYA SATU baris VITE_API_URL. Setelah ganti, wajib build ulang.
# ============================================================

# --- PRODUCTION A: Laravel di subfolder /api (public_html/api) -> endpoint /api/api/v1 ---
VITE_API_URL=https://videalink.my.id/api/api/v1

# --- PRODUCTION B: Laravel di subdomain terpisah (disarankan, URL lebih bersih) ---
# VITE_API_URL=https://api.videalink.my.id/api/v1

# --- LOCAL (untuk tes build lokal) ---
# VITE_API_URL=http://127.0.0.1:8000/api/v1
